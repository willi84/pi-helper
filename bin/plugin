#!/bin/bash
# DESC: Install a plugin from a repo or template

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
LIB_DIR="$SCRIPT_DIR/../lib"
CONFIG_FILE="$SCRIPT_DIR/../config/plugins.json"

source "$LIB_DIR/index.sh"

show_plugin_templates() {
    display_headline "🔌 Plugin templates" >&2
}

prompt_for_plugin_repo() {
    local options=()
    local repos=()
    local line
    local name
    local rest
    local repo
    local desc
    local selected_index
    local manual_repo
    local option
    local i

    while IFS= read -r line; do
        name="${line%%|*}"
        rest="${line#*|}"
        repo="${rest%%|*}"
        desc="${rest#*|}"
        options+=("$name - $desc")
        repos+=("$repo")
    done < <(read_plugin_config "$CONFIG_FILE")

    options+=("Manual repository")

    while true; do
        show_plugin_templates
        for i in "${!options[@]}"; do
            printf '%s) %s\n' "$((i + 1))" "${options[$i]}" >&2
        done
        printf '#? ' >&2
        read -r option

        [ -n "$option" ] || {
            echo "❌ Invalid selection" >&2
            continue
        }

        case "$option" in
            ''|*[!0-9]*)
                echo "❌ Invalid selection" >&2
                continue
                ;;
        esac

        selected_index=$((option - 1))
        [ "$selected_index" -ge 0 ] || {
            echo "❌ Invalid selection" >&2
            continue
        }

        if [ "$selected_index" -lt "${#repos[@]}" ]; then
            printf '%s\n' "${repos[$selected_index]}"
            return 0
        fi

        if [ "$selected_index" -ne "${#repos[@]}" ]; then
            echo "❌ Invalid selection" >&2
            continue
        fi

        read -r -p "Repository (org/repo): " manual_repo
        is_valid_repo "$manual_repo" || {
            echo "❌ Invalid repository format: $manual_repo" >&2
            return 1
        }
        printf '%s\n' "$manual_repo"
        return 0
    done
}

install_plugin() {
    local repo="$1"
    local tmp_dir

    is_valid_repo "$repo" || {
        echo "❌ Invalid repository format: $repo" >&2
        return 1
    }

    tmp_dir="$(mktemp -d /tmp/pi-plugin.XXXXXX)"
    trap 'rm -rf "$tmp_dir"' EXIT

    echo "📥 Cloning plugin $repo..."
    clone_plugin_repo "$repo" "$tmp_dir"

    echo "🚀 Running install.sh..."
    run_plugin_installer "$tmp_dir" "$repo"
    save_installed_plugin_repo "$repo"
    save_last_plugin_repo "$repo"

    trap - EXIT
    rm -rf "$tmp_dir"
    echo "✅ Plugin installed: $repo"
}

main() {
    local repo="${1:-}"

    if [ -z "$repo" ]; then
        repo="$(prompt_for_plugin_repo)"
    fi

    is_valid_repo "$repo" || {
        echo "❌ Invalid repository format: $repo" >&2
        exit 1
    }

    install_plugin "$repo"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
