#!/bin/bash
# DESC: Update the last installed plugin and revise env values

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
LIB_DIR="$SCRIPT_DIR/../lib"

source "$LIB_DIR/index.sh"

main() {
  local repo="${1:-}"
  update_plugin "$repo"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
